# PINs (required in production)
ADMIN_PIN=change-me-admin
SCORER_PIN=change-me-scorer
# Auction console / projector (admin PIN also works)
AUCTIONEER_PIN=change-me-auctioneer
# Optional: publish gallery photos without admin/scorer (dev default 3333)
GALLERY_PIN=change-me-gallery

# Added automatically when you connect "Upstash for Redis" in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (Storage → Blob) — required in production for the photo gallery
BLOB_READ_WRITE_TOKEN=
# Optional store id (set automatically when you connect Blob on Vercel)
BLOB_STORE_ID=
# public | private — must match the store you created (new stores are usually private)
BLOB_ACCESS=private

# Optional: use a different key to run another tournament on the same database
TOURNAMENT_KEY=tnhvpl-s5
